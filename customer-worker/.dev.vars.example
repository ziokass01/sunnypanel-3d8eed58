# Public/proxy settings
PUBLIC_API_BASE_URL=https://mityangho.id.vn/api
ACTIVE_SUPABASE_URL=https://your-project-ref.supabase.co
ACTIVE_FUNCTIONS_BASE_URL=
UPSTREAM_ANON_KEY=PASTE_SB_PUBLISHABLE_KEY_HERE
ALLOWED_ORIGINS=https://mityangho.id.vn,https://admin.mityangho.id.vn,http://127.0.0.1:5500,http://localhost:5500
ALLOWED_FUNCTIONS=verify-key,rent-verify-key,free-config,free-start,free-gate,free-reveal,free-resolve,free-close,reset-key,generate-license-key,admin-free-test,free-admin-test,admin-free-block,admin-free-delete-session,admin-free-delete-issued,admin-rent,admin-rent-integrations,rent-user,server-app-runtime,server-app-runtime-ops,fake-lag-check,fake-lag-auth

# Keep native verify OFF until the migration, secrets and signature checks all pass.
VERIFY_NATIVE_ENABLED=0

# Cloudflare-native verify secrets. Use `wrangler secret put` in production.
# Never expose the service-role key or private signing key to the menu/frontend.
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY_HERE
VERIFY_RESPONSE_ECDSA_PRIVATE_KEY_PEM=PASTE_THE_EXISTING_V10_1_PKCS8_PRIVATE_KEY_PEM_HERE

# Immutable contract of the already released SRC V10.1.
VERIFY_REQUIRED_BUILD_ID=sunny-v34-ac-20260721
VERIFY_PRODUCT_ID=sunny-free-fire
VERIFY_RESPONSE_ECDSA_KEY_ID=sunny-p256-2026-07-b
VERIFY_REQUIRE_DEVICE_KEY=0
VERIFY_SESSION_TTL_SECONDS=900
VERIFY_RPC_TIMEOUT_MS=12000
VERIFY_AUDIT_SUCCESS=1

# Database-side limits retained from the Edge Function.
VERIFY_IP_RATE_LIMIT=300
VERIFY_IP_RATE_WINDOW_SECONDS=60
VERIFY_KEY_RATE_LIMIT=60
VERIFY_KEY_RATE_WINDOW_SECONDS=300
VERIFY_NEW_DEVICE_LIMIT=20
VERIFY_NEW_DEVICE_WINDOW_SECONDS=3600
VERIFY_ENUM_FAILURE_5M_LIMIT=80
VERIFY_ENUM_DISTINCT_10M_LIMIT=100
VERIFY_ENUM_BLOCK_MINUTES=15
VERIFY_MAX_BODY_BYTES=8192

# Required only while verify-key still runs in old proxy mode.
GATEWAY_SHARED_SECRET=PASTE_EXISTING_GATEWAY_SECRET_HERE

# Local development only. Never set this to 1 in production.
ALLOW_UNBOUND_RATE_LIMITS=1
