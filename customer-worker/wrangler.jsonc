{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "sunnypanel",
  "main": "index.js",
  "compatibility_date": "2026-07-21",

  "workers_dev": false,
  "preview_urls": false,

  "ratelimits": [
    {
      "name": "VERIFY_RATE_LIMITER",
      "namespace_id": "2026080401",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],

  "route": {
    "pattern": "mityangho.id.vn/api/*",
    "zone_name": "mityangho.id.vn"
  },

  "keep_vars": true
}
