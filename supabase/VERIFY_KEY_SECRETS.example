# Do NOT commit real values.
# Keep the exact request-HMAC value used by the currently released menu.
# The server reads VERIFY_REQUEST_HMAC_SECRET first and temporarily falls back
# to VERIFY_HMAC_SECRET. The GitHub workflows synchronize both aliases.
VERIFY_REQUEST_HMAC_SECRET=PASTE_CURRENT_RELEASED_MENU_REQUEST_HMAC_SECRET
VERIFY_HMAC_SECRET=PASTE_THE_SAME_VALUE_FOR_TRANSITIONAL_COMPATIBILITY

# Gateway secret: use the same random value in exactly two server locations:
# Cloudflare GATEWAY_SHARED_SECRET and Supabase VERIFY_GATEWAY_SHARED_SECRET.
VERIFY_GATEWAY_SHARED_SECRET=PASTE_SERVER_ONLY_GATEWAY_SECRET
VERIFY_REQUIRE_GATEWAY=1

# Paste the full PKCS#8 PEM, including BEGIN/END lines.
VERIFY_RESPONSE_ECDSA_PRIVATE_KEY_PEM=PASTE_PKCS8_PRIVATE_KEY_PEM_HERE
VERIFY_RESPONSE_ECDSA_KEY_ID=sunny-p256-2026-07-b

VERIFY_REQUIRED_BUILD_ID=sunny-v34-ac-20260721
VERIFY_PRODUCT_ID=sunny-free-fire
VERIFY_SESSION_TTL_SECONDS=900
VERIFY_REQUIRE_DEVICE_KEY=0
